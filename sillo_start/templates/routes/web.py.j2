"""Web routes — pages served to a browser.

These are registered directly on the application rather than mounted as a
router. A router with no prefix becomes a mount at ``/``, which claims the
entire URL tree{% if admin.enabled %} — including {{ admin.prefix }}, whose routes the admin panel
registers during startup, after mounting has finished{% endif %}. Registering the handlers
individually keeps each path exact.
"""

from __future__ import annotations

from sillo import silloApp
from sillo.core.http import Request, Response
{% if inertia.enabled %}

from app.inertia import inertia
{% endif %}
{% if inertia.enabled %}


async def home(request: Request, response: Response) -> Response:
    """Render the landing page through Inertia."""
    return await inertia.render(
        request,
        response,
        "Home",
        {"message": "Welcome to {{ title }}."},
    )
{% else %}


async def home(request: Request, response: Response) -> Response:
    """Render the landing page."""
    return response.html(
        "<!doctype html>"
        "<title>{{ title }}</title>"
        "<h1>{{ title }}</h1>"
        "<p>Your Sillo application is running.</p>"
    )
{% endif %}


def register(application: silloApp) -> None:
    """Attach the web routes to *application*.

    Add new pages here. For a section with its own prefix — ``/blog``, say —
    a `Router(prefix="/blog")` mounted with `application.mount_router()` is
    fine; only the prefix-less case has to be registered this way.
    """
    application.get("/", handler=home, name="home", exclude_from_schema=True)
