.DEFAULT_GOAL := help
.PHONY: help install dev test lint format check migrate build clean

help:  ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'

install:  ## Install dependencies
{% if tooling.package_manager == "uv" %}
	uv sync
{% else %}
	pip install -e ".[dev]"
{% endif %}
{% if inertia.enabled %}
	cd {{ inertia.frontend_path }} && {{ inertia.package_manager }} install
{% endif %}

dev:  ## Run every development service
	sillo-start dev

test:  ## Run the test suite
	pytest

lint:  ## Check formatting and lint rules
	ruff check .
	ruff format --check .
{% if tooling.mypy %}
	mypy .
{% endif %}

format:  ## Fix formatting and auto-fixable lint errors
	ruff format .
	ruff check --fix .

check: lint test  ## Lint and test

{% if uses_record %}
migrate:  ## Apply pending migrations
	sillo-start migrate run
{% endif %}

build:  ## Build for production
{% if inertia.enabled %}
	cd {{ inertia.frontend_path }} && {{ inertia.package_manager }} run build
{% endif %}
	@echo "Build complete."

clean:  ## Remove caches and build artefacts
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	rm -rf .pytest_cache .ruff_cache .mypy_cache htmlcov .coverage
