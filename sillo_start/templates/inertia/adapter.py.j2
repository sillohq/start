"""Inertia adapter.

Handlers render pages through this object::

    from app.inertia import inertia

    @router.get("/dashboard")
    async def dashboard(request, response):
        return await inertia.render(request, response, "Dashboard", {"stats": stats})

The component name maps to a file under
``{{ frontend }}/src/pages`` — "Dashboard" resolves to
``pages/Dashboard.{{ extension }}``.
"""

from __future__ import annotations

import os
from pathlib import Path

{% if adapter == "react" %}
from sillo_inertia import Inertia, vite_react
{% elif adapter == "vue" %}
from sillo_inertia import Inertia, vite_vue
{% else %}
from dataclasses import dataclass

from sillo_inertia import Inertia
from sillo_inertia.vite import ViteOptions, render_vite_vue_tags
{% endif %}

from app.config import config

#: Project root, from which the root view and the build manifest are resolved.
BASE_DIR = Path(__file__).resolve().parent.parent

# These are read defensively rather than off `config` directly, so that adding
# Inertia to a project whose `app/config.py` predates it still works. Declare
# `vite_dev_server: str` and `vite_dev: bool` on AppConfig to make them typed
# settings like the rest.
VITE_DEV_SERVER: str = getattr(
    config, "vite_dev_server", os.getenv("VITE_DEV_SERVER", "http://localhost:{{ inertia.port }}")
)
VITE_DEV: bool = getattr(
    config, "vite_dev", os.getenv("VITE_DEV", "true").lower() == "true"
)
{% if adapter == "svelte" %}


# TODO(sillo): sillo_inertia ships vite_react() and vite_vue() but no Svelte
# helper. This subclass fills the gap locally rather than importing something
# that does not exist; the tags Svelte's Vite plugin needs are the same ones
# the Vue variant emits. Replace this with `vite_svelte()` if the framework
# grows one.
@dataclass(frozen=True, slots=True)
class ViteSvelteOptions(ViteOptions):
    """Vite tag rendering for a Svelte entry point."""

    def render_tags(self, base_dir: Path) -> str:
        return render_vite_vue_tags(self, base_dir)


def vite_svelte(
    *,
    entry: str = "{{ entry }}",
    dev_server: str = "http://localhost:{{ inertia.port }}",
    manifest_path: str = "{{ frontend }}/dist/.vite/manifest.json",
    asset_prefix: str = "/assets/",
    dev: bool = True,
) -> ViteSvelteOptions:
    """Build the Vite options for the Svelte frontend."""
    return ViteSvelteOptions(
        entry=entry,
        dev_server=dev_server.rstrip("/"),
        manifest_path=manifest_path,
        asset_prefix=asset_prefix,
        dev=dev,
    )
{% endif %}


#: The adapter. `app.bootstrap` attaches its middleware to the application.
inertia = Inertia(
    root_view=str(BASE_DIR / "{{ inertia.root_view }}"),
    base_dir=BASE_DIR,
{% if adapter == "react" %}
    vite=vite_react(
        entry="{{ entry }}",
        dev_server=VITE_DEV_SERVER,
        manifest_path="{{ frontend }}/dist/.vite/manifest.json",
        dev=VITE_DEV,
    ),
{% elif adapter == "vue" %}
    vite=vite_vue(
        entry="{{ entry }}",
        dev_server=VITE_DEV_SERVER,
        manifest_path="{{ frontend }}/dist/.vite/manifest.json",
        dev=VITE_DEV,
    ),
{% else %}
    vite=vite_svelte(
        entry="{{ entry }}",
        dev_server=VITE_DEV_SERVER,
        manifest_path="{{ frontend }}/dist/.vite/manifest.json",
        dev=VITE_DEV,
    ),
{% endif %}
)


def share_defaults() -> None:
    """Share props with every page.

    Shared props are merged into each response, which is how things like the
    signed-in user or flash messages reach every component without being
    threaded through each handler.
    """
    inertia.share(app_name=config.app_name)
