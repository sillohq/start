import { defineConfig } from "vite";
{% if adapter == "react" %}
import react from "@vitejs/plugin-react";
{% elif adapter == "vue" %}
import vue from "@vitejs/plugin-vue";
{% else %}
import { svelte } from "@sveltejs/vite-plugin-svelte";
{% endif %}
import { resolve } from "node:path";

// Sillo reads dist/.vite/manifest.json to find the built asset names, so the
// manifest must be enabled and the entry must be explicit — Vite's default
// index.html entry does not apply here, because the HTML is served by Sillo.
export default defineConfig({
  plugins: [
{% if adapter == "react" %}
    react(),
{% elif adapter == "vue" %}
    vue(),
{% else %}
    svelte(),
{% endif %}
  ],
  resolve: {
    alias: {
      "@": resolve(__dirname, "src"),
    },
  },
  server: {
    port: {{ inertia.port }},
    strictPort: true,
    // The backend is a different origin during development.
    cors: true,
    origin: "http://localhost:{{ inertia.port }}",
  },
  build: {
    manifest: true,
    outDir: "dist",
    emptyOutDir: true,
    rollupOptions: {
      input: "{{ entry }}",
    },
  },
});
