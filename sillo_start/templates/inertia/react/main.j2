import { createInertiaApp } from "@inertiajs/react";
import { createRoot } from "react-dom/client";

// Pages are resolved eagerly so a page component is never a network round trip
// away. Swap to `import.meta.glob("./pages/**/*.tsx")` (lazy) once the page
// count makes the initial bundle worth splitting.
const pages = import.meta.glob("./pages/**/*.tsx", { eager: true });

createInertiaApp({
  resolve: (name) => {
    const page = pages[`./pages/${name}.tsx`];
    if (!page) {
      throw new Error(
        `Inertia page "${name}" was not found. Expected src/pages/${name}.tsx.`,
      );
    }
    return page;
  },
  setup({ el, App, props }) {
    createRoot(el).render(<App {...props} />);
  },
  progress: { color: "#29d" },
});
