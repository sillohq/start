import { createInertiaApp } from "@inertiajs/svelte";
import { mount } from "svelte";

// Pages are resolved eagerly so a page component is never a network round trip
// away. Swap to a lazy `import.meta.glob` once splitting the initial bundle is
// worth the extra request.
const pages = import.meta.glob("./pages/**/*.svelte", { eager: true });

createInertiaApp({
  resolve: (name) => {
    const page = pages[`./pages/${name}.svelte`];
    if (!page) {
      throw new Error(
        `Inertia page "${name}" was not found. Expected src/pages/${name}.svelte.`,
      );
    }
    return page;
  },
  setup({ el, App, props }) {
    mount(App, { target: el, props });
  },
  progress: { color: "#29d" },
});
