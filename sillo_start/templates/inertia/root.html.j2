{#
  The Inertia root view.

  This file is not a Jinja template at runtime — sillo_inertia does plain
  string replacement on it for each request. It substitutes:

    {{ '{{ inertia }}' }}       the <script type="application/json"> element
                                holding the page object, which is where Inertia
                                2.x and later look for it
    {{ '{{ root_id }}' }}       the mount element id (default "app")
    {{ '{{ inertia_head }}' }}  the head tags, which is where the Vite
                                script/style tags are injected

  plus any key passed as view_data. The double braces below are emitted
  literally so those replacements find them.

  Do not put the page on the root div as data-page: that was the Inertia 1.x
  convention and current versions never read it, so the client boots with a
  null page and throws "Cannot read properties of null (reading 'component')".
#}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}</title>
    {{ '{{ inertia_head }}' }}
  </head>
  <body>
    <div id="{{ '{{ root_id }}' }}"></div>
    {{ '{{ inertia }}' }}
  </body>
</html>
