"""Authorization rules for {{ pascal }}.

Each method answers one question about one user and one record. Handlers call
these instead of inlining permission checks, so the rules stay in one place
and can be tested directly.
"""

from __future__ import annotations

from typing import Any


class {{ pascal }}:
    """Who may do what with a {{ human | lower }}."""

    def view_any(self, user: Any) -> bool:
        """May *user* list these at all?"""
        return bool(user and user.is_authenticated)

    def view(self, user: Any, record: Any) -> bool:
        """May *user* see this record?"""
        return self.view_any(user)

    def create(self, user: Any) -> bool:
        """May *user* create one?"""
        return bool(user and user.is_authenticated)

    def update(self, user: Any, record: Any) -> bool:
        """May *user* change this record?

        The default is ownership: the owner, or a superuser. Adjust to match
        your model's field for the owning user.
        """
        if not user or not user.is_authenticated:
            return False
        if getattr(user, "is_superuser", False):
            return True
        return getattr(record, "user_id", None) == getattr(user, "id", None)

    def delete(self, user: Any, record: Any) -> bool:
        """May *user* delete this record?"""
        return self.update(user, record)
