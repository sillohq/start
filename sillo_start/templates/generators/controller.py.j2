"""HTTP handlers for {{ pascal }}."""

from __future__ import annotations

from sillo import Router
from sillo.core.http import Request, Response

router = Router(prefix="{{ api.prefix }}/{{ plural | replace('_', '-') }}", tags=["{{ plural }}"])


@router.get("/", summary="List {{ plural }}")
async def index(request: Request, response: Response) -> Response:
    """Return every {{ human | lower }}."""
    return response.json([])


@router.get("/{item_id:int}", summary="Fetch one {{ snake }}")
async def show(request: Request, response: Response, item_id) -> Response:
    """Return one {{ human | lower }} by id.

    The `:int` converter in the path means `item_id` arrives already coerced.
    """
    return response.json({"id": item_id})


@router.post("/", summary="Create a {{ snake }}")
async def store(request: Request, response: Response) -> Response:
    """Create a {{ human | lower }}.

    Add `request_model=` to this decorator to have the body validated and
    injected as the next parameter.
    """
    return response.json({}, status_code=201)


@router.patch("/{item_id:int}", summary="Update a {{ snake }}")
async def update(request: Request, response: Response, item_id) -> Response:
    """Update a {{ human | lower }}."""
    return response.json({"id": item_id})


@router.delete("/{item_id:int}", summary="Delete a {{ snake }}")
async def destroy(request: Request, response: Response, item_id) -> Response:
    """Delete a {{ human | lower }}."""
    return response.empty(status_code=204)
