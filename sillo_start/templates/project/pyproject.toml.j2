[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project.name | kebab }}"
version = "{{ project.version }}"
description = "{{ project.description }}"
readme = "README.md"
requires-python = "{{ project.python }}"
dependencies = [
{% for requirement in dependencies %}
    "{{ requirement }}",
{% endfor %}
]

[project.optional-dependencies]
dev = [
{% for requirement in dev_dependencies %}
    "{{ requirement }}",
{% endfor %}
]

[tool.hatch.build.targets.wheel]
packages = ["app"]

{% if tooling.pytest %}
[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
addopts = "-q"
{% endif %}
{% if tooling.ruff %}

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"__init__.py" = ["F401"]
{% endif %}
{% if tooling.mypy %}

[tool.mypy]
python_version = "3.11"
ignore_missing_imports = true
warn_unused_ignores = true
disallow_untyped_defs = false
files = ["app"{% if uses_record %}, "database"{% endif %}]
{% endif %}
{% if tooling.coverage %}

[tool.coverage.run]
source = ["app"{% if uses_record %}, "database"{% endif %}]
omit = ["*/tests/*"]

[tool.coverage.report]
show_missing = true
skip_covered = true
{% endif %}
{% if uses_record %}

# Migrations are Tortoise-native; the config lives in database/config.py and
# the migration package is declared there under apps.models.migrations.
{% endif %}

# Sillo project manifest — the source of truth for `sillo-start`. It records
# what this application is and which features are enabled, and drives `add`,
# `remove`, `dev`, `doctor` and `generate`. Edit it by hand if you like; the
# tool preserves your comments and formatting. The application itself never
# reads it.
{{ sillo_manifest }}