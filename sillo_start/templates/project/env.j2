# {{ title }} environment.
#
# Copy to .env and adjust. Never commit .env — it is gitignored.

# --- Application ---
APP_NAME={{ title }}
APP_ENV=local
DEBUG=true
HOST={{ app.host }}
PORT={{ app.port }}
LOG_LEVEL=info
{% if auth.enabled or session.enabled %}
# Signs sessions and cookies. Generate a fresh one per environment.
SECRET_KEY={{ secret_key }}
{% endif %}
{% if database.enabled %}

# --- Database ---
DATABASE_URL={{ database_url }}
DB_POOL_SIZE=5
DB_ECHO=false
{% endif %}
{% if auth.enabled and auth.strategy in ("jwt", "token") %}

# --- Authentication ---
JWT_SECRET={{ jwt_secret }}
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
{% endif %}
{% if auth.enabled and auth.strategy == "session" %}

# --- Sessions ---
SESSION_COOKIE_NAME={{ session.cookie_name }}
SESSION_LIFETIME={{ session.lifetime }}
{% endif %}
{% if needs_redis %}

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
{% endif %}
{% if admin.enabled %}

# --- Admin ---
ADMIN_ENABLED=true
ADMIN_PREFIX={{ admin.prefix }}
{% endif %}
{% if inertia.enabled %}

# --- Frontend ---
VITE_DEV_SERVER=http://localhost:{{ inertia.port }}
VITE_DEV=true
{% endif %}
{% if api.cors %}

# --- Security ---
CORS_ALLOW_ORIGINS=http://localhost:{{ inertia.port if inertia.enabled else 5173 }}
{% endif %}
{% if mail.enabled and mail.driver != "none" %}

# --- Mail ---
{% if mail.driver == "smtp" %}
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
{% elif mail.driver == "mailpit" %}
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@localhost
{% else %}
MAIL_DRIVER=console
{% endif %}
{% endif %}
{% if storage.enabled and storage.driver == "s3" %}

# --- Storage ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
{% endif %}
